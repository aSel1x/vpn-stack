<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Merged into the host app's manifest. Everything a VpnService needs is
         declared here rather than in app/android/, because app/android/ is
         regenerated by `flutter create` in CI and anything hand-added to it is
         deleted on the next run. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ConnectivityManager: which network is underneath the tunnel, and which
         one DNS for the server's own name is resolved on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- requestNetwork(), which DefaultNetworkMonitor uses from API 26 instead of
         registerDefaultNetworkCallback: from Android P the latter reports the
         VPN's own interface, which would point sing-box at the tun it just
         created. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Android kills a VpnService that is not in the foreground. From API 34 a
         foreground service must also declare a type, and the type for a VPN is
         systemExempted — an app that is the active VPN is exempt by the platform,
         which is why there is no FOREGROUND_SERVICE_TYPE_VPN. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- From API 33 the ongoing notification is not shown without this, and it is
         a runtime permission, so declaring it is only half the job:
         SingboxTunnelPlugin.requestNotifications() asks for it through the same
         Activity seam VpnService.prepare() already uses. The plugin asks and not
         the host app, for the reason this file exists at all — app/android/ is
         regenerated by `flutter create` and a request hand-added there would be
         deleted on the next run. A refusal is not fatal: the service still runs
         and the tunnel still carries traffic, the user just loses the state
         display and the Stop action, which is what the plugin reports to Dart
         rather than leaving them to notice by its absence. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".SingboxVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <!-- The system binds a VpnService through this action and no other.
                 Without the intent-filter, VpnService.prepare() succeeds and
                 Builder.establish() then returns null, which is the silent
                 not-connected this plugin exists to never produce. -->
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <!-- Always-on VPN, which the framework drives through the
                 intent-filter above: it starts this service itself, with NO
                 extras, and starts it again if it dies. Absent meta-data already
                 means supported — this key exists to opt OUT, by being false —
                 so declaring it true changes no behaviour and states the intent,
                 which is worth a line because the feature is only real if the
                 service can start without an Intent from the app.
                 SingboxVpnService.resolveStartRequest() is that half: the
                 configuration is persisted on every app-initiated start and read
                 back on every start that carries none. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
    </application>
</manifest>
