# libbox.aar is ~60 MB of built Go, produced by the `libbox` job in
# .github/workflows/app.yml from sing-box's own source at the version compose.yml
# pins. A build artifact, not a source file, and this repository is public.
android/libs/*.aar

# Generated by a local `flutter pub get` in this package; carries absolute paths
# into whoever ran it, the same reason app/.dart_tool is ignored.
.dart_tool/
build/
