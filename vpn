#!/bin/bash
# ./vpn -- the operator's entry point. Runs on YOUR machine.
#
# Deliberately dumb: it holds no state, no config file, no cached user list and
# no secrets. Anything it does not recognise is forwarded verbatim to vpnctl on
# the server, so the CLI surface is defined in exactly one place.
#
# This file is a placeholder for a future app's SSH transport, which is why its
# remote surface is kept to three operations: run a command, push a tar, pull a
# file. A second implementation (libssh2/russh/paramiko, for Windows and mobile
# where OpenSSH is not on PATH) then costs a day, not a rewrite.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${VPN_HOST:-}"
SSH_KEY="${VPN_SSH_KEY:-}"
REMOTE_PATH="${VPN_REMOTE_PATH:-/opt/vpn-stack}"

if [[ -z "$HOST" && -f "$REPO/.vpn-host" ]]; then
  HOST="$(<"$REPO/.vpn-host")"
fi

ssh_opts=(-o StrictHostKeyChecking=accept-new)
[[ -n "$SSH_KEY" ]] && ssh_opts+=(-i "$SSH_KEY")

need_host() {
  if [[ -z "$HOST" ]]; then
    cat >&2 <<MSG
No server configured. Either:
  ./vpn init <user@host>          set one up (writes .vpn-host, gitignored)
  VPN_HOST=<user@host> ./vpn ...  for a one-off
MSG
    exit 2
  fi
}

# One SSH call, one lock. That is the whole multi-operator story: two people
# running ./vpn at once serialise instead of interleaving writes to users.json.
#
# vpnctl now takes this same lock itself for every mutating command, and this
# one is still load-bearing rather than belt-and-braces: it covers the whole
# remote command -- the cd and everything forwarded after it -- while vpnctl's
# own window opens after argument parsing and closes when the process exits.
# vpnctl's is also non-blocking by design, so without an outer lock two
# overlapping operators get one refusal instead of two runs that queue.
remote() {
  need_host
  # -t only when we actually have a terminal, or ssh warns on every scripted call
  local tty=()
  [[ -t 0 && -t 1 ]] && tty=(-t)
  [[ " $* " == *" --json "* ]] && tty=()
  # Quote every argument for the remote shell. `$*` unquoted is re-split there,
  # so anything with a space or a glob character silently becomes several
  # arguments -- or, with the wrong input, something else entirely.
  local cmd
  cmd="$(printf '%q ' "$@")"
  # REMOTE_PATH is quoted for the same reason the arguments are: it comes from
  # the environment, and a path with a space in it is re-split by the remote
  # shell into two arguments to cd.
  #
  # vpnctl takes this same lock itself now, for every mutating command, so
  # VPN_STACK_LOCK_HELD is what tells its inner lock to stand down. It has to be
  # able to see that an outer flock(1) already holds the file, because flock(1)
  # inside flock(1) on the same path from a child process opens a
  # second file description, which the kernel treats as a different holder, and
  # a blocking lock then waits for a lock its own parent will never release --
  # measured, not assumed.
  # shellcheck disable=SC2029
  ssh "${ssh_opts[@]}" "${tty[@]}" "$HOST" \
    "cd $(printf '%q' "$REMOTE_PATH") && VPN_STACK_LOCK_HELD=1 flock /run/vpn-stack.lock /usr/local/bin/vpnctl $cmd"
}

# The volumes a backup has to carry, and the tar member each one rides in.
# compose.yml declares exactly two named volumes and neither holds anything that
# can be regenerated without consequence:
#
#   ikev2-vpn-data   cert9.db/key4.db -- the NSS database holding the IKEv2 CA
#                    private key. Omit it and every certificate this server ever
#                    issued is unrecoverable.
#   dnstt-sshd-keys  the dnstt SSH front's host key, which is in a volume for the
#                    reason compose.yml states: so it does not change under
#                    clients. Omit it and a restore onto a rebuilt box mints a
#                    new one, and every dnstt client gets a changed-host-key
#                    warning indistinguishable from an attack -- for the one
#                    protocol whose users have no fallback to switch to.
#
# One definition, read by `backup` and by `restore`. The ikev2 name used to be
# written out in both, which is how a two-entry list ends up updated in one place
# -- the same "two literals drift" argument check.sh applies to the sing-box tag.
#
# The member names are on-disk format: every backup already taken carries
# .vpn-state.tgz and .vpn-ikev2.tgz, so those never change, and restore treats
# any member a given backup does not have as absent rather than as an error.
BACKUP_VOLUMES=(
  "vpn-stack_ikev2-vpn-data:.vpn-ikev2.tgz"
  "vpn-stack_dnstt-sshd-keys:.vpn-dnstt-sshd-keys.tgz"
)

# The server half of a backup: one tar, on stdout, with the state directory as
# .vpn-state.tgz and one member per volume above.
backup_stream() {
  ssh "${ssh_opts[@]}" "$HOST" bash -s -- "${BACKUP_VOLUMES[@]}" <<'REMOTE'
set -euo pipefail
# umask 077, a private temp directory, and a trap -- none of it decoration. The
# two intermediates used to be created by plain shell redirection into /tmp at
# root's umask (0022, so 0644) in a world-traversable directory, and the `rm -f`
# that removed them ran only if the final `tar c` had succeeded. Break the pipe
# -- the local age dies, the ssh drops, the operator Ctrl-Cs -- and
# /tmp/.vpn-state.tgz stayed there indefinitely at a predictable path: every
# user's password on every protocol, the REALITY private key and the NSS CA
# private key, readable by any account on the box.
umask 077
tmp=$(mktemp -d)
# HUP as well as EXIT: when the far end goes away sshd HUPs this shell, and an
# untrapped HUP kills it WITHOUT running the EXIT trap -- which is precisely the
# broken-pipe case the temp files used to survive.
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
# Why a temp directory at all, given that nothing here wants the plaintext on
# disk: tar writes each member's SIZE into that member's header, so a member has
# to exist in full before it can be streamed. The two-member layout is format --
# `restore` opens .vpn-state.tgz by name -- so it does not change.
#
# No 2>/dev/null on this line any more. It discarded the reason the one tar that
# matters had failed, and tar's stderr travels the ssh session's stderr to the
# operator's terminal, not the stdout stream age is reading, so there is nothing
# it can corrupt.
#
# rendered-* is excluded on purpose: it is derived, `vpnctl apply` rebuilds it,
# and a backup should hold only what cannot be remade.
tar cz -C /etc/vpn-stack --exclude='./rendered*' . > "$tmp/.vpn-state.tgz"
members=(.vpn-state.tgz)
for pair in "$@"; do
  vol=${pair%%:*}; member=${pair#*:}
  # A volume that does not exist yet (dnstt never enabled) is created empty by
  # this run and tars to an empty member, so the stream's shape is the same
  # whatever is switched on. An empty member restores to an empty volume, which
  # is what a box that never ran dnstt had anyway.
  docker run --rm -v "$vol":/v alpine tar cz -C /v . > "$tmp/$member"
  members+=("$member")
done
tar c -C "$tmp" "${members[@]}"
REMOTE
}

# Where the backup identity lives: on THIS machine, outside the repo, and never
# on the server. `age -p` was the old scheme and its whole security was one
# passphrase a human had to be able to type -- which is also the reason a single
# committed .age file was a real incident rather than a shrug. An age identity is
# high-entropy by construction and is never typed.
#
# The trade-off is real and points the other way: a passphrase you remember
# cannot be lost with a laptop. Keep this file in a password manager -- it is one
# line of text -- because a backup whose key is gone is indistinguishable from no
# backup, and the moment you find out is the moment the server is already gone.
BACKUP_KEY="${VPN_BACKUP_KEY:-$HOME/.config/vpn-stack/backup.key}"

need_backup_key() {
  command -v age >/dev/null || { echo "install age(1) first" >&2; exit 1; }
  [[ -f "$BACKUP_KEY" ]] && return 0
  cat >&2 <<EOF
no backup identity at $BACKUP_KEY

Create one, then copy it into your password manager:

  ./vpn backup-key

Backups are encrypted to that identity instead of to a passphrase. Existing
passphrase-encrypted .age files still restore -- \`./vpn restore\` detects which
kind it was handed.
EOF
  exit 1
}

case "${1:-}" in
  init)
    target="${2:?usage: ./vpn init <user@host>}"
    shift 2
    # Recorded before the install, not after. It is only a pointer to what you
    # typed, and writing it afterwards meant a failed install left ./vpn with
    # no host at all -- so the obvious next command answered "No server
    # configured" instead of saying anything about the real failure.
    #
    # The whole target, user included. Stripping it left every later ./vpn call
    # connecting as the local user instead of root, which fails with a
    # permission error that says nothing about where it came from.
    echo "$target" > "$REPO/.vpn-host"
    bash "$REPO/scripts/install.sh" "$target" "$@"
    ;;

  deploy)
    need_host
    SSH_OPTS="${ssh_opts[*]}" REPO_PATH="$REMOTE_PATH" bash "$REPO/scripts/deploy.sh" "$HOST"
    ;;

  share)
    need_host
    name="${2:?usage: ./vpn share <user> [--bind <addr>] [--port N]}"
    shift 2
    # The credential is fetched to THIS machine and served from here. The VPN
    # server never gains a listener and never learns who you handed it to.
    # Through uv when it is here, so share.py can import qrcode - it is a
    # declared dependency of this project and was simply absent from the system
    # python3, which is why the QR of the link never once appeared. Plain
    # python3 still works as the fallback; the page is identical, only the QR is
    # missing, and share.py now says so instead of skipping it in silence.
    if command -v uv >/dev/null; then
      py=(uv run --quiet --project "$REPO" python)
    else
      py=(python3)
    fi
    remote user export "$name" --json --protocol all \
      | "${py[@]}" "$REPO/scripts/share.py" "$@"
    ;;

  smoke)
    need_host
    ssh "${ssh_opts[@]}" "$HOST" "cd $(printf '%q' "$REMOTE_PATH") && bash scripts/smoke.sh"
    ;;

  backup-key)
    # Deliberately a separate command and not something `backup` creates for
    # you. A key minted silently is a key nobody copied anywhere, and the first
    # time that matters is a restore onto a box whose predecessor is gone.
    command -v age-keygen >/dev/null || { echo "install age(1) first" >&2; exit 1; }
    if [[ -f "$BACKUP_KEY" ]]; then
      echo "already have one: $BACKUP_KEY" >&2
      echo "recipient: $(age-keygen -y "$BACKUP_KEY")" >&2
      echo "Refusing to replace it -- every existing backup is encrypted to it." >&2
      exit 1
    fi
    mkdir -p "$(dirname "$BACKUP_KEY")"
    ( umask 077; age-keygen -o "$BACKUP_KEY" 2>/dev/null )
    chmod 600 "$BACKUP_KEY"
    cat >&2 <<EOF
wrote $BACKUP_KEY (0600)
recipient: $(age-keygen -y "$BACKUP_KEY")

Copy the contents of that file into your password manager NOW. It is one line.
Every backup from here on is encrypted to it and to nothing else, so losing it
loses every backup -- including the ones taken before you noticed it was gone.
It is never sent to the server, and it is outside the repo on purpose.
EOF
    ;;

  backup)
    need_host
    need_backup_key
    # Encrypted here, decrypted only here: the identity never reaches the server
    # and the plaintext never touches THIS machine's disk. On the server it does
    # exist for the length of the transfer -- tar cannot write a member's header
    # without knowing its size -- but only inside a 0700 mktemp directory that a
    # trap removes on exit, on a broken pipe and on a dropped connection alike.
    # See backup_stream: the old wording claimed neither disk and was wrong in a
    # way that mattered, because the files it left in /tmp were 0644.
    out="${2:-}"
    recipient="$(age-keygen -y "$BACKUP_KEY")"
    if [[ -n "$out" ]]; then
      # Written to <out>.partial and renamed only once age has exited 0. The
      # bare-redirect form cannot do this and never will: `./vpn backup > f.age`
      # is the SHELL truncating f.age before ssh has said a word, so a backup
      # that fails half way has already destroyed the last good one, and the
      # occasion you find out is a rebuilt box. Pass the path instead.
      if ( umask 077; backup_stream | age -r "$recipient" > "$out.partial" ); then
        mv -- "$out.partial" "$out"
        echo "wrote $out" >&2
      else
        rc=$?
        # Removed, not kept: a truncated .partial is indistinguishable from a
        # backup by anything except age, and the whole point is that $out --
        # which may be the only copy of the CA key -- is left untouched.
        rm -f -- "$out.partial"
        echo "backup FAILED (status $rc); $out was not written or modified" >&2
        exit "$rc"
      fi
    else
      backup_stream | age -r "$recipient"
    fi
    ;;

  restore)
    need_host
    # The other half of backup. A backup that has never been restored is a
    # hope, not a backup -- and the failure mode it guards against (a rebuilt
    # box) is exactly when you find out.
    command -v age >/dev/null || { echo "install age(1) first" >&2; exit 1; }
    file="${2:?usage: ./vpn restore <file.age> [--force]}"
    [[ -f "$file" ]] || { echo "no such file: $file" >&2; exit 1; }
    force="${3:-}"

    # age records its scheme in the header: `-> scrypt` for a passphrase, an
    # `-> X25519` stanza for a recipient. Sniff it rather than asking, so a
    # backup taken before the identity existed still restores without a flag --
    # and so the wrong answer is an immediate error instead of a prompt that
    # looks like the right one.
    #
    # `-a` is load-bearing, not tidiness. The header is ASCII but the payload
    # right after it is not, so grep calls the stream binary and exits 1 without
    # looking -- which sent every passphrase-era backup down the identity branch
    # and failed it with age's own unhelpful error, on a rebuilt box, which is
    # the only occasion anybody runs this command.
    if head -c 200 "$file" | grep -qa -- '-> scrypt'; then
      age_decrypt=(age -d "$file")
      echo "note: $file is passphrase-encrypted (the old scheme)." >&2
    else
      need_backup_key
      age_decrypt=(age -d -i "$BACKUP_KEY" "$file")
    fi

    # Restoring over a server that already has users overwrites live
    # credentials with older ones, and every profile issued since diverges.
    if [[ "$force" != "--force" ]]; then
      if ssh "${ssh_opts[@]}" "$HOST" 'test -s /etc/vpn-stack/users.json' 2>/dev/null; then
        echo "$HOST already has a user database." >&2
        echo "Restoring would replace it, and every profile issued since this" >&2
        echo "backup was taken would stop working. Re-run with --force if that" >&2
        echo "is what you mean." >&2
        exit 1
      fi
    fi

    echo "Decrypting locally and streaming to $HOST..." >&2
    # The volume list arrives as positional parameters rather than spliced into
    # the script: `set -- <quoted list>` in front of it, because stdin is the
    # backup stream here and so `bash -s` -- how backup_stream ships its half --
    # is not available on this side.
    read -r -d '' restore_remote <<'REMOTE' || true
set -e
umask 077
tmp=$(mktemp -d)
# HUP and the rest alongside EXIT: a dropped connection kills this shell with an
# untrapped signal, and the EXIT trap alone would then never run -- leaving the
# whole decrypted state directory in /tmp on a box that is being rebuilt.
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
tar x -C "$tmp"
# pluto keeps the NSS database open; writing under it corrupts the very thing
# being restored.
docker stop ipsec-vpn-server >/dev/null 2>&1 || true
install -d -m 700 /etc/vpn-stack
tar xz -C /etc/vpn-stack -f "$tmp/.vpn-state.tgz"
for pair in "$@"; do
  vol=${pair%%:*}; member=${pair#*:}
  # Tolerated, not required. Every backup taken before dnstt-sshd-keys joined
  # the list carries the ikev2 member only, and those are exactly the backups
  # this command exists to restore. Reported rather than passed over in
  # silence: a host key that was quietly regenerated is a changed-host-key
  # warning on every dnstt client, days later, with nothing pointing here.
  if [ -f "$tmp/$member" ]; then
    docker volume create "$vol" >/dev/null
    docker run --rm -i -v "$vol":/v alpine tar xz -C /v < "$tmp/$member"
    echo "restored volume $vol"
  else
    echo "note: this backup predates $member; $vol will be regenerated" >&2
  fi
done
echo "restored $(ls /etc/vpn-stack/secrets | wc -l) secrets"
REMOTE
    "${age_decrypt[@]}" | ssh "${ssh_opts[@]}" "$HOST" \
      "set -- $(printf '%q ' "${BACKUP_VOLUMES[@]}")
$restore_remote"

    echo "Converging..." >&2
    remote apply
    ssh "${ssh_opts[@]}" "$HOST" "cd $(printf '%q' "$REMOTE_PATH") && bash scripts/smoke.sh"
    ;;

  logs)
    need_host
    shift
    # Quoted for the remote shell, exactly as remote() does it and for the same
    # reason: `${*}` spliced in raw is re-split and glob-expanded over there, so
    # a service name with a space or a `*` in it stopped being one argument --
    # and this is a command an operator types arguments into by hand.
    svc=("$@")
    [[ ${#svc[@]} -eq 0 ]] && svc=(sing-box)
    ssh "${ssh_opts[@]}" -t "$HOST" \
      "cd $(printf '%q' "$REMOTE_PATH") && docker compose logs -f $(printf '%q ' "${svc[@]}")"
    ;;

  ""|-h|--help|help)
    cat <<MSG
./vpn -- personal VPN operator CLI

  ./vpn init <user@host>      set up a bare Ubuntu server from scratch
  ./vpn deploy                sync code, validate, converge
  ./vpn share <user>          one-shot LAN page: tap-to-import on a phone
  ./vpn smoke                 assert the server is actually serving
  ./vpn backup-key            create the local age identity backups use
  ./vpn backup f.age          encrypted to it, decrypted only on this machine
                              (> f.age also works, but the shell truncates the
                              file before the backup is known to have worked)
  ./vpn restore f.age         put one back on a rebuilt server
  ./vpn logs [service]        tail logs

Everything else is forwarded to vpnctl on the server:

  ./vpn status
  ./vpn user add <name>
  ./vpn user export <name> --qr
  ./vpn protocol list | on <name> | off <name>
MSG
    ;;

  *)
    remote "$@"
    ;;
esac
