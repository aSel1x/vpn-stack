#!/bin/bash
# ./vpn -- the operator's entry point. Runs on YOUR machine.
#
# Deliberately dumb: it holds no state, no config file, no cached user list and
# no secrets. Anything it does not recognise is forwarded verbatim to vpnctl on
# the server, so the CLI surface is defined in exactly one place.
#
# This file is a placeholder for a future app's SSH transport, which is why its
# remote surface is kept to three operations: run a command, push a tar, pull a
# file. A second implementation (libssh2/russh/paramiko, for Windows and mobile
# where OpenSSH is not on PATH) then costs a day, not a rewrite.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${VPN_HOST:-}"
SSH_KEY="${VPN_SSH_KEY:-}"
REMOTE_PATH="${VPN_REMOTE_PATH:-/opt/vpn-stack}"

if [[ -z "$HOST" && -f "$REPO/.vpn-host" ]]; then
  HOST="$(<"$REPO/.vpn-host")"
fi

ssh_opts=(-o StrictHostKeyChecking=accept-new)
[[ -n "$SSH_KEY" ]] && ssh_opts+=(-i "$SSH_KEY")

need_host() {
  if [[ -z "$HOST" ]]; then
    cat >&2 <<MSG
No server configured. Either:
  ./vpn init <user@host>          set one up (writes .vpn-host, gitignored)
  VPN_HOST=<user@host> ./vpn ...  for a one-off
MSG
    exit 2
  fi
}

# One SSH call, one lock. That is the whole multi-operator story: two people
# running ./vpn at once serialise instead of interleaving writes to users.json.
remote() {
  need_host
  # -t only when we actually have a terminal, or ssh warns on every scripted call
  local tty=()
  [[ -t 0 && -t 1 ]] && tty=(-t)
  [[ " $* " == *" --json "* ]] && tty=()
  # Quote every argument for the remote shell. `$*` unquoted is re-split there,
  # so anything with a space or a glob character silently becomes several
  # arguments -- or, with the wrong input, something else entirely.
  local cmd
  cmd="$(printf '%q ' "$@")"
  # shellcheck disable=SC2029
  ssh "${ssh_opts[@]}" "${tty[@]}" "$HOST" \
    "cd $REMOTE_PATH && flock /run/vpn-stack.lock /usr/local/bin/vpnctl $cmd"
}

# Where the backup identity lives: on THIS machine, outside the repo, and never
# on the server. `age -p` was the old scheme and its whole security was one
# passphrase a human had to be able to type -- which is also the reason a single
# committed .age file was a real incident rather than a shrug. An age identity is
# high-entropy by construction and is never typed.
#
# The trade-off is real and points the other way: a passphrase you remember
# cannot be lost with a laptop. Keep this file in a password manager -- it is one
# line of text -- because a backup whose key is gone is indistinguishable from no
# backup, and the moment you find out is the moment the server is already gone.
BACKUP_KEY="${VPN_BACKUP_KEY:-$HOME/.config/vpn-stack/backup.key}"

need_backup_key() {
  command -v age >/dev/null || { echo "install age(1) first" >&2; exit 1; }
  [[ -f "$BACKUP_KEY" ]] && return 0
  cat >&2 <<EOF
no backup identity at $BACKUP_KEY

Create one, then copy it into your password manager:

  ./vpn backup-key

Backups are encrypted to that identity instead of to a passphrase. Existing
passphrase-encrypted .age files still restore -- \`./vpn restore\` detects which
kind it was handed.
EOF
  exit 1
}

case "${1:-}" in
  init)
    target="${2:?usage: ./vpn init <user@host>}"
    shift 2
    # Recorded before the install, not after. It is only a pointer to what you
    # typed, and writing it afterwards meant a failed install left ./vpn with
    # no host at all -- so the obvious next command answered "No server
    # configured" instead of saying anything about the real failure.
    #
    # The whole target, user included. Stripping it left every later ./vpn call
    # connecting as the local user instead of root, which fails with a
    # permission error that says nothing about where it came from.
    echo "$target" > "$REPO/.vpn-host"
    bash "$REPO/scripts/install.sh" "$target" "$@"
    ;;

  deploy)
    need_host
    SSH_OPTS="${ssh_opts[*]}" REPO_PATH="$REMOTE_PATH" bash "$REPO/scripts/deploy.sh" "$HOST"
    ;;

  share)
    need_host
    name="${2:?usage: ./vpn share <user> [--bind <addr>] [--port N]}"
    shift 2
    # The credential is fetched to THIS machine and served from here. The VPN
    # server never gains a listener and never learns who you handed it to.
    # Through uv when it is here, so share.py can import qrcode - it is a
    # declared dependency of this project and was simply absent from the system
    # python3, which is why the QR of the link never once appeared. Plain
    # python3 still works as the fallback; the page is identical, only the QR is
    # missing, and share.py now says so instead of skipping it in silence.
    if command -v uv >/dev/null; then
      py=(uv run --quiet --project "$REPO" python)
    else
      py=(python3)
    fi
    remote user export "$name" --json --protocol all \
      | "${py[@]}" "$REPO/scripts/share.py" "$@"
    ;;

  smoke)
    need_host
    ssh "${ssh_opts[@]}" "$HOST" "cd $REMOTE_PATH && bash scripts/smoke.sh"
    ;;

  backup-key)
    # Deliberately a separate command and not something `backup` creates for
    # you. A key minted silently is a key nobody copied anywhere, and the first
    # time that matters is a restore onto a box whose predecessor is gone.
    command -v age-keygen >/dev/null || { echo "install age(1) first" >&2; exit 1; }
    if [[ -f "$BACKUP_KEY" ]]; then
      echo "already have one: $BACKUP_KEY" >&2
      echo "recipient: $(age-keygen -y "$BACKUP_KEY")" >&2
      echo "Refusing to replace it -- every existing backup is encrypted to it." >&2
      exit 1
    fi
    mkdir -p "$(dirname "$BACKUP_KEY")"
    ( umask 077; age-keygen -o "$BACKUP_KEY" 2>/dev/null )
    chmod 600 "$BACKUP_KEY"
    cat >&2 <<EOF
wrote $BACKUP_KEY (0600)
recipient: $(age-keygen -y "$BACKUP_KEY")

Copy the contents of that file into your password manager NOW. It is one line.
Every backup from here on is encrypted to it and to nothing else, so losing it
loses every backup -- including the ones taken before you noticed it was gone.
It is never sent to the server, and it is outside the repo on purpose.
EOF
    ;;

  backup)
    need_host
    # Streams through the SSH pipe into age on THIS machine: the key never
    # reaches the server and the plaintext never lands on either disk.
    need_backup_key
    # Both halves, and the second is the one people forget: the ikev2 volume
    # holds cert9.db/key4.db, the NSS database with the IKEv2 CA private key.
    # Without it every certificate this server ever issued is unrecoverable.
    # rendered-* is excluded on purpose -- it is derived, `vpnctl apply`
    # rebuilds it, and a backup should contain only what cannot be remade.
    ssh "${ssh_opts[@]}" "$HOST" '
      set -e
      tar cz -C /etc/vpn-stack --exclude="./rendered*" . 2>/dev/null > /tmp/.vpn-state.tgz
      docker run --rm -v vpn-stack_ikev2-vpn-data:/v alpine tar cz -C /v . > /tmp/.vpn-ikev2.tgz
      tar c -C /tmp .vpn-state.tgz .vpn-ikev2.tgz
      rm -f /tmp/.vpn-state.tgz /tmp/.vpn-ikev2.tgz' \
      | age -r "$(age-keygen -y "$BACKUP_KEY")"
    ;;

  restore)
    need_host
    # The other half of backup. A backup that has never been restored is a
    # hope, not a backup -- and the failure mode it guards against (a rebuilt
    # box) is exactly when you find out.
    command -v age >/dev/null || { echo "install age(1) first" >&2; exit 1; }
    file="${2:?usage: ./vpn restore <file.age> [--force]}"
    [[ -f "$file" ]] || { echo "no such file: $file" >&2; exit 1; }
    force="${3:-}"

    # age records its scheme in the header: `-> scrypt` for a passphrase, an
    # `-> X25519` stanza for a recipient. Sniff it rather than asking, so a
    # backup taken before the identity existed still restores without a flag --
    # and so the wrong answer is an immediate error instead of a prompt that
    # looks like the right one.
    #
    # `-a` is load-bearing, not tidiness. The header is ASCII but the payload
    # right after it is not, so grep calls the stream binary and exits 1 without
    # looking -- which sent every passphrase-era backup down the identity branch
    # and failed it with age's own unhelpful error, on a rebuilt box, which is
    # the only occasion anybody runs this command.
    if head -c 200 "$file" | grep -qa -- '-> scrypt'; then
      age_decrypt=(age -d "$file")
      echo "note: $file is passphrase-encrypted (the old scheme)." >&2
    else
      need_backup_key
      age_decrypt=(age -d -i "$BACKUP_KEY" "$file")
    fi

    # Restoring over a server that already has users overwrites live
    # credentials with older ones, and every profile issued since diverges.
    if [[ "$force" != "--force" ]]; then
      if ssh "${ssh_opts[@]}" "$HOST" 'test -s /etc/vpn-stack/users.json' 2>/dev/null; then
        echo "$HOST already has a user database." >&2
        echo "Restoring would replace it, and every profile issued since this" >&2
        echo "backup was taken would stop working. Re-run with --force if that" >&2
        echo "is what you mean." >&2
        exit 1
      fi
    fi

    echo "Decrypting locally and streaming to $HOST..." >&2
    "${age_decrypt[@]}" | ssh "${ssh_opts[@]}" "$HOST" '
      set -e
      umask 077
      tmp=$(mktemp -d)
      trap "rm -rf \"$tmp\"" EXIT
      tar x -C "$tmp"
      # pluto keeps the NSS database open; writing under it corrupts the very
      # thing being restored.
      docker stop ipsec-vpn-server >/dev/null 2>&1 || true
      install -d -m 700 /etc/vpn-stack
      tar xz -C /etc/vpn-stack -f "$tmp/.vpn-state.tgz"
      docker volume create vpn-stack_ikev2-vpn-data >/dev/null
      docker run --rm -i -v vpn-stack_ikev2-vpn-data:/v alpine \
        tar xz -C /v < "$tmp/.vpn-ikev2.tgz"
      echo "restored $(ls /etc/vpn-stack/secrets | wc -l) secrets"'

    echo "Converging..." >&2
    remote apply
    ssh "${ssh_opts[@]}" "$HOST" "cd $REMOTE_PATH && bash scripts/smoke.sh"
    ;;

  logs)
    need_host
    shift
    ssh "${ssh_opts[@]}" -t "$HOST" "cd $REMOTE_PATH && docker compose logs -f ${*:-sing-box}"
    ;;

  ""|-h|--help|help)
    cat <<MSG
./vpn -- personal VPN operator CLI

  ./vpn init <user@host>      set up a bare Ubuntu server from scratch
  ./vpn deploy                sync code, validate, converge
  ./vpn share <user>          one-shot LAN page: tap-to-import on a phone
  ./vpn smoke                 assert the server is actually serving
  ./vpn backup-key            create the local age identity backups use
  ./vpn backup > f.age        encrypted to it, decrypted only on this machine
  ./vpn restore f.age         put one back on a rebuilt server
  ./vpn logs [service]        tail logs

Everything else is forwarded to vpnctl on the server:

  ./vpn status
  ./vpn user add <name>
  ./vpn user export <name> --qr
  ./vpn protocol list | on <name> | off <name>
MSG
    ;;

  *)
    remote "$@"
    ;;
esac
